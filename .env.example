# ============================================================
# AXIS CONTENT HUB — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Cloudflare R2 (Primary File Storage) ─────────────────────
# Found in: Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=axis-content-primary
# Public URL for your R2 bucket (set up a custom domain or use the public URL)
R2_PUBLIC_URL=https://pub-your-hash.r2.dev

# ── Backblaze B2 (Backup Storage) ────────────────────────────
# Found in: Backblaze Dashboard → App Keys
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_ACCESS_KEY_ID=your-b2-key-id
B2_SECRET_ACCESS_KEY=your-b2-application-key
B2_BUCKET_NAME=axis-content-backup

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AI (Claude) ───────────────────────────────────────────────
# Found in: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Vercel Cron (MIS scheduled pulls) ────────────────────────
# Any random secret string — must match what Vercel sends as Authorization: Bearer <secret>
CRON_SECRET=your-random-secret-here

# ── Google Analytics / Search Console / YouTube ──────────────
# Service account: GCP Console → IAM & Admin → Service Accounts → Keys → JSON
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GA4 property IDs (numbers only, e.g. 123456789) — GA4 → Admin → Property Settings
GA4_PROPERTY_ID_MAIN=123456789
GA4_PROPERTY_ID_ES=987654321
# Search Console site URLs (exact match, trailing slash) — Search Console → Settings
GSC_SITE_URL_MAIN=https://www.yoursite.com/
GSC_SITE_URL_ES=https://www.yoursite.es/
# YouTube Data API v3 key — GCP Console → APIs & Services → Credentials → API key
# Must have "YouTube Data API v3" enabled in GCP
YOUTUBE_API_KEY=AIza...
# YouTube channel ID — youtube.com → your channel → About → Share → Copy channel ID
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxxx

# ── Brevo (Email Campaign Stats) ─────────────────────────────
# Found in: app.brevo.com → Settings → SMTP & API → API Keys tab
# Use the v3 API key (starts with xkeysib-). NOT the SMTP password. NOT the MCP key.
BREVO_API_KEY=xkeysib-...

# ── Zoho CRM Integration ──────────────────────────────────────
# Create a Server-based OAuth app at: https://api-console.zoho.com/
# Set redirect URI to: https://your-app.vercel.app/api/zoho/callback
# Scopes needed: ZohoCRM.modules.leads.READ,ZohoCRM.users.READ
ZOHO_CLIENT_ID=1000.xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZOHO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZOHO_REDIRECT_URI=https://your-app.vercel.app/api/zoho/callback
